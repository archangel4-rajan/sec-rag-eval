# Copy to .env and fill in. Never commit .env.

# SEC EDGAR requires a User-Agent identifying your name and email.
# https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT="Rajan Anand rajan@example.com"

# LLM providers
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Together / Groq for Llama experiments (Day 9)
TOGETHER_API_KEY=
GROQ_API_KEY=

# Langfuse (Day 8) — leave blank for now, populate when self-hosting
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Local paths (defaults usually fine)
DATA_DIR=./data
CHROMA_PATH=./data/chroma
